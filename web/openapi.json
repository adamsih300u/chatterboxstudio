    "/api/audio/decode": {
      "post": {
        "description": "Any audio ffmpeg reads (M4B audiobooks included) as a mono WAV window, so the browser\nnever has to decode a whole book.",
        "operationId": "decode_audio_api_audio_decode_post",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "default": 0.0,
              "title": "Start",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "seconds",
            "required": false,
            "schema": {
              "default": 1800.0,
              "title": "Seconds",
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_decode_audio_api_audio_decode_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Decode Audio"
      }
    },
